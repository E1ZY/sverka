# Docker Compose reads this variable. Use a URL-safe value.
POSTGRES_PASSWORD=local-audit-password
# Docker host binding: local / SSH tunnel by default; 0.0.0.0 enables external IPv4 access.
BIND_ADDRESS=127.0.0.1
# Choose access with: python3 scripts/configure_auth.py --http
# local: no login, localhost only; password: shared password (safe default).
AUTH_MODE=password
# In password mode an empty hash keeps data inaccessible. Never put plaintext here.
AUTH_PASSWORD_HASH=
AUTH_COOKIE_SECURE=true
# Direct Windows/Python OCR: tesseract, or xiaomi after scripts/setup_xiaomi_ocr.py.
OCR_PROVIDER=tesseract
# XIAOMI_OCR_MODEL=.runtime/models/xiaomi-ocr-0
# XIAOMI_OCR_DEVICE=auto
# XIAOMI_OCR_MAX_NEW_TOKENS=4096
# XIAOMI_OCR_TIMEOUT=180
# Docker has its own defaults, independent of the direct Windows/Python settings.
DOCKER_OCR_PROVIDER=xiaomi
# auto selects CUDA if exposed to the container, otherwise CPU.
# GPU hosts enable access once with compose.override.yaml; CPU hosts need no override.
DOCKER_OCR_DEVICE=auto
# Default image supports both NVIDIA CUDA and CPU execution.
# PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
# Direct local execution defaults to SQLite and an embedded worker.
# DATABASE_URL=postgresql+psycopg://audit:password@127.0.0.1:5432/reconciliation
# DATA_DIR=D:/Coding/Hackathon/data
# EMBED_WORKER=true
# TESSDATA_PREFIX=D:/Coding/Hackathon/.runtime/tessdata
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# FIXTURES_DIR=D:/Coding/Hackathon/cases
